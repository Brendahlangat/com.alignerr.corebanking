<?xml version="1.0" encoding="UTF-8"?>
<ser:proxyServiceEntry xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:con="http://www.bea.com/wli/sb/services/security/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oper="http://xmlns.oracle.com/servicebus/proxy/operations" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env">
    <ser:coreEntry isAutoPublish="false">
        <ser:description/>
        <ser:binding type="SOAP" xsi:type="con:SoapBindingType" isSoap12="true" xmlns:con="http://www.bea.com/wli/sb/services/bindings/config">
            <con:wsdl ref="ESBMetadata/ComponentLibrary/ProviderServices/Core Banking/Transfer/V1/TransferPS"/>
            <con:port>
                <con:name>TransferPSPort</con:name>
                <con:namespace>http://xmlns.Brenda/ESB/PS/Core Banking/Transfer/V1</con:namespace>
            </con:port>
            <con:selector type="SOAP header">
                <con:locator>.</con:locator>
                <con:mapping operation="createPOThruFI" value="&quot;createPOThruFI&quot;"/>
                <con:mapping operation="createNEFTInward" value="&quot;createNEFTInward&quot;"/>
                <con:mapping operation="createEFTOutward" value="&quot;createEFTOutward&quot;"/>
                <con:mapping operation="createRTGSInward" value="&quot;createRTGSInward&quot;"/>
                <con:mapping operation="queryRTGSOutwardRefStatus" value="&quot;queryRTGSOutwardRefStatus&quot;"/>
                <con:mapping operation="queryNEFTOutwardRefStatus" value="&quot;queryNEFTOutwardRefStatus&quot;"/>
                <con:mapping operation="xferTrnAdd" value="&quot;xferTrnAdd&quot;"/>
                <con:mapping operation="customxferTrnAdd" value="&quot;customxferTrnAdd&quot;"/>
                <con:mapping operation="reverseTransaction" value="&quot;reverseTransaction&quot;"/>
                <con:mapping operation="interCountryXfer" value="&quot;interCountryXfer&quot;"/>
            </con:selector>
            <con:WSI-compliant>false</con:WSI-compliant>
        </ser:binding>
        <oper:operations enabled="true" xmlns:cus="http://www.bea.com/wli/config/customizations" xmlns:xt="http://www.bea.com/wli/config/xmltypes"/>
        <ser:ws-policy>
            <ser:binding-mode>no-policies</ser:binding-mode>
        </ser:ws-policy>
        <ser:invoke ref="Core BankingProv/Pipeline/CORE_XferAddTransferPP" xsi:type="con1:PipelineRef" xmlns:con1="http://www.bea.com/wli/sb/pipeline/config"/>
        <ser:xqConfiguration>
            <ser:snippetVersion>1.0</ser:snippetVersion>
        </ser:xqConfiguration>
    </ser:coreEntry>
    <ser:endpointConfig>
        <tran:provider-id>http</tran:provider-id>
        <tran:inbound>true</tran:inbound>
        <tran:URI>
            <env:value>/ESB/PS/Core Banking/SOAP/AddTransfer</env:value>
        </tran:URI>
        <tran:inbound-properties/>
        <tran:all-headers>true</tran:all-headers>
        <tran:provider-specific xsi:type="http:HttpEndPointConfiguration" xmlns:http="http://www.bea.com/wli/sb/transports/http">
            <http:inbound-properties/>
        </tran:provider-specific>
    </ser:endpointConfig>
</ser:proxyServiceEntry>