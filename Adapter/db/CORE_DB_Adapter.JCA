<?xml version="1.0" encoding="utf-8"?>
<con:jcaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
  <con:jca><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<adapter-config xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata" name="CoreDemoDBAdapter" adapter="db" wsdlLocation="CORE_DB_Adapter.wsdl">
  <connection-factory UIConnectionName="Demo Records" location="eis/DB/DemoRecords" />
  <endpoint-interaction portType="Core BankingDBAdapterPort" operation="queryCustomerAccount">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="SELECT tenant_id tenantId, record_reference accountReference, currency_code AccountCcy, branch_code Branch, record_label accountLabel, created_date OpenDate, record_id recordId, record_type AccountType, category_code ProductCd, category_label AccCategory, status_code ClosureFlag, status_date ClosureDate, activity_status InactiveStatus, source_tenant_id sourceTenantId, associated_record_id associatedRecordId, display_name displayName, external_reference externalReference, owner_name assignedOwnerName, address_line_1 addressLine1, address_line_2 addressLine2, address_line_3 addressLine3, locality locality, country_code CountryCode, postal_code postalCode, phone_number phoneNumber, mobile_number mobileNumber, email_address emailAddress, location_code locationCode, record_category recordCategory, record_subcategory recordSubcategory, status Status FROM DEMO_RECORDS WHERE tenant_id = #tenantId AND record_id = #internalRecordId AND external_reference = #externalRecordId" />
      <property name="GetActiveUnitOfWork" value="false" />
    </interaction-spec>
  </endpoint-interaction>

  <endpoint-interaction portType="Core BankingDBAdapterPort" operation="inquireAccount">
    <interaction-spec className="oracle.tip.adapter.db.DBPureSQLInteractionSpec">
      <property name="SqlString" value="SELECT tenant_id tenantId, record_reference accountReference, currency_code AccountCcy, branch_code Branch, record_label accountLabel, created_date OpenDate, record_id recordId, record_type AccountType, category_code ProductCd, category_label AccCategory, status_code ClosureFlag, status_date ClosureDate, activity_status InactiveStatus, source_tenant_id sourceTenantId, associated_record_id associatedRecordId, display_name displayName, external_reference externalReference, owner_name assignedOwnerName, address_line_1 addressLine1, address_line_2 addressLine2, address_line_3 addressLine3, locality locality, country_code CountryCode, postal_code postalCode, phone_number phoneNumber, mobile_number mobileNumber, email_address emailAddress, location_code locationCode, record_category recordCategory, record_subcategory recordSubcategory, status Status FROM DEMO_RECORDS WHERE tenant_id = #tenantId AND record_id = #internalRecordId AND external_reference = #externalRecordId" />
      <property name="GetActiveUnitOfWork" value="false" />
    </interaction-spec>
  </endpoint-interaction>

</adapter-config>]]></con:jca>
  <con:jcaDependency>
    <con:wsdlRef wsdlLocation="CORE_DB_Adapter.wsdl" ref="Core BankingProv/Business/CORE_DB_Adapter" />
  </con:jcaDependency>
</con:jcaEntry>