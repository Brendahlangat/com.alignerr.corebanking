<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://xmlns.Brenda/ESB/EO/Parties/Customer/V1"
           xmlns="http://xmlns.Brenda/ESB/EO/Parties/Customer/V1"
           elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>
      Generic project Customer envelope based on the request and response structures used by the current transformations.
      This is not an organization-approved canonical Enterprise Object contract.
    </xs:documentation>
  </xs:annotation>
  <xs:element name="ESBMsg" type="ESBMsgType" />
  <xs:complexType name="ESBMsgType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="RqData" type="CustomerRequestDataType" />
        <xs:element name="RsData" type="CustomerResponseDataType" />
      </xs:choice>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CustomerRequestDataType">
    <xs:sequence>
      <xs:element name="Customer" type="CustomerType" minOccurs="0" maxOccurs="unbounded" />
      <xs:any namespace="##other" minOccurs="0" maxOccurs="unbounded" processContents="skip" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CustomerResponseDataType">
    <xs:sequence>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="Customer" type="CustomerType" />
        <xs:any namespace="##other" processContents="skip" />
      </xs:choice>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="CustomerType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip" />
    </xs:sequence>
  </xs:complexType>
</xs:schema>
