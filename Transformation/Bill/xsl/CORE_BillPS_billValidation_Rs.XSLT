  <!--User Editing allowed BELOW this line - DO NOT DELETE THIS LINE-->
  <xsl:template match="/">
    <eo:ESBMsg>
      <com:MsgID>
        <xsl:value-of select="/app:FIXML/app:Header/app:ResponseHeader/app:RequestMessageKey/app:RequestUUID"/>
      </com:MsgID>
      <eo:RsData>
        <eo:Bill>
          <com:BillIdentifier>
            <com:AccountID>
              <xsl:value-of select="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:BILLER_ACCOUNT"/>
            </com:AccountID>
            <com:BillerID>
              <xsl:value-of select="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:Biller_ID"/>
            </com:BillerID>
            <com:BillID>
              <xsl:value-of select="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:Bill_ID"/>
            </com:BillID>
          </com:BillIdentifier>
          <eo:BillName>
            <xsl:value-of select="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:Bill_ID_NAME"/>
          </eo:BillName>
          <xsl:choose>
            <xsl:when test="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:StattusCode ='1'">
              <eo:BillStatus>True</eo:BillStatus>
            </xsl:when>
            <xsl:otherwise>
              <eo:BillStatus>False</eo:BillStatus>
            </xsl:otherwise>
          </xsl:choose>
        </eo:Bill>
        <xsl:choose>
          <xsl:when test="count (/app:FIXML/app:Body/app:Error ) &lt;= 0">
            <com:Status>
            
            <!--status Success-->  
             
              
               <xsl:choose>
            <xsl:when test="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:StattusCode ='1'">
               <com:Code>ESB-00</com:Code>
              <com:Type>
                <xsl:value-of select="/app:FIXML/app:Header/app:ResponseHeader/app:HostTransaction/app:Status"/>
              </com:Type>
               <com:Text>
                <!--Bill queried successfully-->
                <xsl:value-of select="concat ('Biller Account is ', /app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:BILLER_ACCOUNT)"/>
              </com:Text>
              </xsl:when>
              <xsl:otherwise>
              <com:Code>ESB-100</com:Code>
              <com:Type>
                FAILED = <xsl:value-of select="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:StattusCode"/>
              </com:Type>
              <com:Text>
              <!--Bill not valid-->
                <xsl:value-of select="/app:FIXML/app:Body/app:executeCore BankingScriptResponse/app:executeCore BankingScript_CustomData/app:Error"/>
               </com:Text>
               </xsl:otherwise>
              </xsl:choose>
              
             <!--status-->  
              
              
            </com:Status>
          </xsl:when>
          <xsl:otherwise>
            <com:Status>
              <com:Code>ESB-100</com:Code>
              <com:Type>Failure</com:Type>
              <xsl:choose>
                <xsl:when test="count (/app:FIXML/app:Body/app:Error/app:FIBusinessException ) > 0">
                  <com:Text>
                    <xsl:value-of select="concat ('ErrorCode ', /app:FIXML/app:Body/app:Error/app:FIBusinessException/app:ErrorDetail/app:ErrorCode, ',  ErrorDesc ', /app:FIXML/app:Body/app:Error/app:FIBusinessException/app:ErrorDetail/app:ErrorDesc )"/>
                  </com:Text>
                </xsl:when>
                <xsl:otherwise>
                  <xsl:choose>
                    <xsl:when test="count (/app:FIXML/app:Body/app:Error/app:FISystemException ) > 0">
                      <com:Text>
                        <xsl:value-of select="concat ('ErrorCode ', /app:FIXML/app:Body/app:Error/app:FISystemException/app:ErrorDetail/app:ErrorCode, ',  ErrorDesc ', /app:FIXML/app:Body/app:Error/app:FISystemException/app:ErrorDetail/app:ErrorDesc )"/>
                      </com:Text>
                    </xsl:when>
                    <xsl:otherwise>
                      <com:Text>Unable to reach Core Banking</com:Text>
                    </xsl:otherwise>
                  </xsl:choose>
                </xsl:otherwise>
              </xsl:choose>
            </com:Status>
          </xsl:otherwise>
        </xsl:choose>
      </eo:RsData>
    </eo:ESBMsg>
  </xsl:template>
