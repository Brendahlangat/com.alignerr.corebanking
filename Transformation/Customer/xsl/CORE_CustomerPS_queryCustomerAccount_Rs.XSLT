<con:xsltEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
  <con:xslt><![CDATA[<xsl:stylesheet version="1.0" exclude-result-prefixes="xsi oracle-xsl-mapper xsl xsd ns0 tns oraxsl DVMFunctions BasicCredentialsUserFunction UUIDUserFunction IsUserInRoleFunction IsUserInGroupFunction XrefFunctions" xmlns:oraxsl="http://www.oracle.com/XSL/Transform/java" xmlns:DVMFunctions="http://www.oracle.com/XSL/Transform/java/com.bea.wli.sb.functions.dvm.DVMFunctions" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:BasicCredentialsUserFunction="http://www.oracle.com/XSL/Transform/java/com.bea.wli.sb.stages.functions.BasicCredentialsUserFunction" xmlns:oracle-xsl-mapper="http://www.oracle.com/xsl/mapper/schemas" xmlns:UUIDUserFunction="http://www.oracle.com/XSL/Transform/java/com.bea.wli.sb.stages.functions.UUIDUserFunction" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:app="http://xmlns.Brenda/ESB/PS/Core Banking/Adapter/db" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:eo="http://xmlns.Brenda/ESB/EO/Parties/Customer/V1" xmlns:IsUserInRoleFunction="http://www.oracle.com/XSL/Transform/java/com.bea.wli.sb.stages.functions.IsUserInRoleFunction" xmlns:IsUserInGroupFunction="http://www.oracle.com/XSL/Transform/java/com.bea.wli.sb.stages.functions.IsUserInGroupFunction" xmlns:XrefFunctions="http://www.oracle.com/XSL/Transform/java/com.bea.wli.sb.functions.xref.XrefFunctions" xmlns:acceo="http://xmlns.Brenda/ESB/EO/Accounts/Account/V1" xmlns:com="http://xmlns.Brenda/ESB/EO/Common/V1" xmlns:ns1="http://xmlns.Brenda/ESB/EO/Resilience/Biometric/V1">
  <oracle-xsl-mapper:schema>
    <!--SPECIFICATION OF MAP SOURCES AND TARGETS, DO NOT MODIFY.-->
    <oracle-xsl-mapper:mapSources>
      <oracle-xsl-mapper:source type="XSD">
        <oracle-xsl-mapper:schema location="../../../Business/CORE_DB_Adapter.xsd"/>
        <oracle-xsl-mapper:rootElement name="QueryCustomerAccountOutputCollection" namespace="http://xmlns.Brenda/ESB/PS/Core Banking/Adapter/db"/>
      </oracle-xsl-mapper:source>
    </oracle-xsl-mapper:mapSources>
    <oracle-xsl-mapper:mapTargets>
      <oracle-xsl-mapper:target type="XSD">
        <oracle-xsl-mapper:schema location="../../../MDS/CustomerEO.xsd"/>
        <oracle-xsl-mapper:rootElement name="ESBMsg" namespace="http://xmlns.Brenda/ESB/EO/Parties/Customer/V1"/>
      </oracle-xsl-mapper:target>
    </oracle-xsl-mapper:mapTargets>
    <!--GENERATED BY ORACLE XSL MAPPER 12.1.3.0.0(XSLT Build 140529.0700.0211) AT [THU MAY 21 14:34:33 IST 2015].-->
  </oracle-xsl-mapper:schema>
  <!--User Editing allowed BELOW this line - DO NOT DELETE THIS LINE-->
  <xsl:template match="/">
    <eo:ESBMsg>
      <eo:RsData>
        <xsl:for-each select="/app:QueryCustomerAccountOutputCollection/app:QueryCustomerAccountOutput">
          <eo:Customer>
            <com:CustomerIdentifier>
              <com:BankID>
                <xsl:value-of select="app:tenantId"/>
              </com:BankID>
              <com:CustomerID>
                <xsl:value-of select="app:recordId"/>
              </com:CustomerID>
              <com:BranchID>
                <xsl:value-of select="app:locationCode"/>
              </com:BranchID>
            </com:CustomerIdentifier>
            <eo:CustomerType>
              <xsl:value-of select="app:recordCategory"/>
            </eo:CustomerType>
            <eo:CustomerCategoryType>
              <xsl:value-of select="app:recordSubcategory"/>
            </eo:CustomerCategoryType>
            <com:Person>
              <com:PersonName>
                <com:FullName>
                  <xsl:value-of select="app:displayName"/>
                </com:FullName>
              </com:PersonName>
            </com:Person>
            <com:addressText>
              <com:LineOne>
                <xsl:value-of select="app:addressLine1"/>
              </com:LineOne>
              <com:LineTwo>
                <xsl:value-of select="app:addressLine2"/>
              </com:LineTwo>
              <com:LineThree>
                <xsl:value-of select="app:addressLine3"/>
              </com:LineThree>
              <com:CityName>
                <xsl:value-of select="app:locality"/>
              </com:CityName>
              <com:CountryName>
                <xsl:value-of select="app:CountryCode"/>
              </com:CountryName>
              <com:PostalCode>
                <xsl:value-of select="app:postalCode"/>
              </com:PostalCode>
            </com:addressText>
            <com:Phone>
              <com:PhoneType>CELL</com:PhoneType>
              <com:CompleteNumber>
                <xsl:value-of select="app:mobileNumber"/>
              </com:CompleteNumber>
            </com:Phone>
            <com:Phone>
              <com:PhoneType>PHONE</com:PhoneType>
              <com:LocalNumber>
                <xsl:value-of select="app:phoneNumber"/>
              </com:LocalNumber>
            </com:Phone>
            <xsl:if test="string-length (app:emailAddress/text()) >0">
              <com:emailAddress>
                <com:EmailAddress>
                  <xsl:value-of select="app:emailAddress"/>
                </com:EmailAddress>
              </com:emailAddress>
            </xsl:if>
            <acceo:Account>
              <com:AccountIdentifier>
                <com:BankID>
                  <xsl:value-of select="app:sourceTenantId"/>
                </com:BankID>
                <com:BranchID>
                  <xsl:value-of select="app:Branch"/>
                </com:BranchID>
                <com:AccountID>
                  <xsl:value-of select="app:accountReference"/>
                </com:AccountID>
                <com:AccountCurrency>
                  <xsl:value-of select="app:AccountCcy"/>
                </com:AccountCurrency>
              </com:AccountIdentifier>
              <acceo:AccountType>
                <xsl:value-of select="app:AccountType"/>
              </acceo:AccountType>
              <acceo:AccountSubType>
                <xsl:value-of select="app:ProductCd"/>
              </acceo:AccountSubType>
              <acceo:AccountOpenDate>
                <xsl:value-of select="app:OpenDate"/>
              </acceo:AccountOpenDate>
              <acceo:AccountOwnership>
                <xsl:value-of select="app:AccCategory"/>
              </acceo:AccountOwnership>
              <eo:Customer>
                <com:CustomerIdentifier>
                  <com:CustomerID>
                    <xsl:value-of select="app:associatedRecordId"/>
                  </com:CustomerID>
                </com:CustomerIdentifier>
                <com:Person>
                  <com:PersonName>
                    <com:FullName>
                      <xsl:value-of select="app:accountLabel"/>
                    </com:FullName>
                  </com:PersonName>
                </com:Person>
              </eo:Customer>
              <acceo:AccountClosureFlag>
                <xsl:value-of select="app:ClosureFlag"/>
              </acceo:AccountClosureFlag>
              <com:EndDate>
                <xsl:value-of select="app:ClosureDate"/>
              </com:EndDate>
              <acceo:AccountStatus>
                <xsl:value-of select="app:InactiveStatus"/>
              </acceo:AccountStatus>
            </acceo:Account>
            <com:RelationshipManagerName>
              <xsl:value-of select="app:assignedOwnerName"/>
            </com:RelationshipManagerName>
            <com:PrimaryIdentityDocument>
              <com:IdentityDocumentID>
                <xsl:value-of select="app:externalReference"/>
              </com:IdentityDocumentID>
            </com:PrimaryIdentityDocument>
            <eo:CustomerStatus>
              <xsl:value-of select="app:Status"/>
            </eo:CustomerStatus>
          </eo:Customer>
        </xsl:for-each>
        <xsl:if test="count(/app:QueryCustomerAccountOutputCollection/app:QueryCustomerAccountOutput) > 0">
          <com:Status>
            <com:Code>ESB-00</com:Code>
            <com:Type>Success</com:Type>
            <com:Text>Customer account query completed successfully</com:Text>
          </com:Status>
        </xsl:if>
        <xsl:if test="count(/app:QueryCustomerAccountOutputCollection/app:QueryCustomerAccountOutput) &lt;= 0">
          <com:Status>
            <com:Code>ESB-100</com:Code>
            <com:Type>Failue</com:Type>
            <com:Text>Customer accounts not found</com:Text>
          </com:Status>
        </xsl:if>
      </eo:RsData>
    </eo:ESBMsg>
  </xsl:template>
</xsl:stylesheet>]]></con:xslt>
  <con:dependencies>
    <con:mapperDependency location="../../../Business/CORE_DB_Adapter.xsd">
      <con:schema ref="Core BankingProv/Business/CORE_DB_Adapter" />
    </con:mapperDependency>
    <con:mapperDependency location="../../../MDS/CustomerEO.xsd">
      <con:schema ref="Core BankingProv/MDS/CustomerEO" />
    </con:mapperDependency>
  </con:dependencies>
</con:xsltEntry>